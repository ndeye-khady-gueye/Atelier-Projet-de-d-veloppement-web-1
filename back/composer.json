{
    "name": "nrv/back",
    "description": "NRV.net - API de billetterie du festival Nancy Rock Vibration",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "slim/slim": "^4.14",
        "slim/psr7": "^1.7",
        "php-di/php-di": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "nrv\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "nrv\\tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
